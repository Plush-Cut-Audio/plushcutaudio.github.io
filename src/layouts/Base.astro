---
/**
 * The frame around every page: <head>, header, footer, reel player.
 * Pages use it like:  <Base title="Team"> ...page content... </Base>
 */
import "@/styles/theme.css";
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ReelDialog from "@/components/ReelDialog.astro";
import ThemePicker from "@/components/ThemePicker.astro";
import { site, reelMode } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title, description = site.description, home = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.descriptor}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Browser tab icons. Source files are in /public. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/Quicksand.ttf" as="font" type="font/ttf" crossorigin />
    <meta name="theme-color" content="#111111" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Theme preview: runs before the page paints so there is no flash.
      // ?theme=name picks a theme and remembers it; ?preview shows the picker.
      (function () {
        var html = document.documentElement;
        var q = new URLSearchParams(location.search);
        var store = {
          get: function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
          set: function (k, v) { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch (e) {} },
        };
        if (q.has("theme")) store.set("pca-theme", q.get("theme") === "ink" ? null : q.get("theme"));
        if (q.has("preview")) store.set("pca-preview", q.get("preview") === "off" ? null : "1");
        var theme = store.get("pca-theme");
        if (theme) html.dataset.theme = theme;
        if (store.get("pca-preview")) html.dataset.preview = "";
      })();
    </script>
  </head>
  <body class={home ? "is-home" : undefined} data-reel-mode={reelMode}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ReelDialog />
    <ThemePicker />
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
