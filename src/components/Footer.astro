---
import Mark from "@/components/Mark.astro";
import { site, socials } from "@/data/site";

interface Props {
  /** Show the email address (off on the Connect page, where it's the headline). */
  email?: boolean;
}

const { email = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <Mark class="site-footer__mark" />
    {(email || socials.length > 0) && (
      <ul class="site-footer__links">
        {email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        {socials.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>
        ))}
      </ul>
    )}
    <p>&copy; {year} {site.name}</p>
  </div>
</footer>
