---
/**
 * The signature mark (temporary logo).
 * <Mark />          static mark
 * <Mark animate />  signs itself on page load (used once, on the home page)
 * Its color comes from --color-logo in theme.css, or from the CSS `color`
 * of whatever class you pass in.
 */
import { LOGO_VIEWBOX, LOGO_SHAPE, LOGO_PEN } from "@/data/logo";

interface Props {
  animate?: boolean;
  class?: string;
  label?: string;
}

const { animate = false, class: className = "", label } = Astro.props;
---

<svg
  class={`mark ${className}`}
  viewBox={LOGO_VIEWBOX}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  {animate && (
    <defs>
      <mask id="signature-pen" maskUnits="userSpaceOnUse" x="-40" y="-40" width="660" height="980">
        {LOGO_PEN.map((seg) => (
          <path
            class="mark-pen"
            d={seg.d}
            pathLength="1"
            fill="none"
            stroke="#fff"
            stroke-width={seg.w}
            stroke-linecap="round"
            stroke-linejoin="round"
            style={`--at:${seg.at};--for:${seg.for}`}
          />
        ))}
      </mask>
    </defs>
  )}
  <path
    d={LOGO_SHAPE}
    fill="currentColor"
    fill-rule="evenodd"
    mask={animate ? "url(#signature-pen)" : undefined}
  />
  {animate && (
    <path class="mark-settle" d={LOGO_SHAPE} fill="currentColor" fill-rule="evenodd" />
  )}
</svg>
