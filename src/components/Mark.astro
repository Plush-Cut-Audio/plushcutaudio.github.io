---
/**
 * The signature mark (temporary logo), as a crisp vector: used small, in the
 * header and footer. The home page shows the hand-painted version instead
 * (src/components/LogoReveal.astro).
 * Its color comes from --color-logo in theme.css, or from the CSS `color`
 * of whatever class you pass in.
 */
import { LOGO_VIEWBOX, LOGO_SHAPE } from "@/data/logo";

interface Props {
  class?: string;
  label?: string;
}

const { class: className = "", label } = Astro.props;
---

<svg
  class={`mark ${className}`}
  viewBox={LOGO_VIEWBOX}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <path d={LOGO_SHAPE} fill="currentColor" fill-rule="evenodd" />
</svg>
