---
/**
 * The pop-up video player. One per page; any link with data-reel-src
 * opens it. See src/scripts/site.js for the behavior.
 */
---

<dialog class="reel-dialog" data-reel-dialog aria-label="Reel">
  <button class="reel-dialog__close" type="button" data-reel-close>Close</button>
  <div class="reel-dialog__stage" data-reel-stage></div>
</dialog>
