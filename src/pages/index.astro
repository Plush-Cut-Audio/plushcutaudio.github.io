---
import Base from "@/layouts/Base.astro";
import Swash from "@/components/Swash.astro";
import Mark from "@/components/Mark.astro";
import PlayIcon from "@/components/PlayIcon.astro";
import { site } from "@/data/site";
---

<Base home>
  <section class="hero container">
    <h1 class="visually-hidden">{site.name}</h1>
    <Mark animate class="hero__mark" />
    <p class="wordmark hero__wordmark" aria-hidden="true">{site.name}</p>
    <p class="hero__descriptor">{site.descriptor}</p>

    <div class="hero__actions">
      <!-- Plays the showreel in the pop-up player. Video: site.showreel in site.ts -->
      <a href={site.showreel.src} data-reel-src={site.showreel.src} data-reel-title="Plush Cut Audio showreel">
        <PlayIcon label="Listen" />
      </a>
      <!-- Main call to action. The swash under it is always drawn. -->
      <a class="hero__connect" href="/contact/">
        Connect
        <Swash />
      </a>
    </div>
  </section>
</Base>
