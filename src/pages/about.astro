---
import Base from "@/layouts/Base.astro";
import Swash from "@/components/Swash.astro";
import { about, site } from "@/data/site";

// Either a list of paragraphs or one text with blank lines ("\n\n") between them
const paragraphs: string[] = (Array.isArray(about.paragraphs) ? about.paragraphs : about.paragraphs.split(/\n\s*\n/))
  .map((p) => p.trim())
  .filter(Boolean);

// The last word of each ending is shown in the accent color
const first = about.visionEndings[0];
const cut = first.lastIndexOf(" ") + 1;
---

<Base title="About" fullscreen bare>
  <section class="vision container">
    <span class="vision__mark" aria-hidden="true"></span>
    <h1 class="vision__statement">
      <span class="visually-hidden">{about.vision} {about.visionEndings[0]}</span>
      <!-- The visible line: the ending types, holds, deletes and moves on.
           Every ending sits invisibly in the same spot so the line keeps the
           width of the longest one and the start never shifts. -->
      <span aria-hidden="true">
        {about.vision}{" "}
        <span class="typer" data-typer={JSON.stringify(about.visionEndings)}>
          {about.visionEndings.map((e) => <span class="typer__sizer">{e}</span>)}
          <span class="typer__live"><span data-typer-text><span data-typer-lead>{first.slice(0, cut)}</span><span class="typer__accent" data-typer-accent>{first.slice(cut)}</span></span><span class="typer__caret"></span></span>
        </span>
      </span>
    </h1>
    {paragraphs.length > 0 && (
      <button class="vision__more swash-link" type="button" data-dialog-open="about-more" aria-haspopup="dialog">
        Read more
        <Swash />
      </button>
    )}
  </section>

  <script>
    // Typing effect for the end of the vision line. Starts with the first
    // ending already shown, holds it, then deletes and types the next.
    const TIMING = {
      type: 85, // ms per letter typed
      erase: 40, // ms per letter deleted
      hold: 2400, // ms a finished ending stays up
      gap: 450, // ms of empty space before the next ending types
    };

    const typer = document.querySelector<HTMLElement>("[data-typer]");
    const text = typer?.querySelector<HTMLElement>("[data-typer-text]");
    const lead = typer?.querySelector<HTMLElement>("[data-typer-lead]");
    const accent = typer?.querySelector<HTMLElement>("[data-typer-accent]");
    const endings: string[] = typer ? JSON.parse(typer.dataset.typer || "[]") : [];
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (typer && text && lead && accent && endings.length > 1 && !still) {
      const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
      const setTyping = (on: boolean) => typer.classList.toggle("is-typing", on);
      // Show the first n letters, with the last word in the accent color
      const show = (word: string, n: number) => {
        const cut = word.lastIndexOf(" ") + 1;
        const shown = word.slice(0, n);
        lead.textContent = shown.slice(0, cut);
        accent.textContent = shown.slice(cut);
      };

      (async () => {
        for (let i = 0; ; i = (i + 1) % endings.length) {
          const word = endings[i];
          if (i > 0 || text.textContent !== word) {
            setTyping(true);
            for (let n = 1; n <= word.length; n++) {
              show(word, n);
              await wait(TIMING.type);
            }
          }
          setTyping(false);
          await wait(TIMING.hold);
          setTyping(true);
          for (let n = word.length - 1; n >= 0; n--) {
            show(word, n);
            await wait(TIMING.erase);
          }
          setTyping(false);
          await wait(TIMING.gap);
        }
      })();
    }
  </script>

  <!-- The About text, opened by "Read more" above -->
  <dialog class="reading" id="about-more" aria-labelledby="about-more-title" data-dialog>
    <div class="reading__panel">
      <button class="reading__close" type="button" data-dialog-close>Close</button>
      <h2 class="reading__title" id="about-more-title">About {site.name}</h2>
      <div class="reading__body">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </dialog>
</Base>
