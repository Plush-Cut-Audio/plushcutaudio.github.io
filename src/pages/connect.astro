---
import Swash from "@/components/Swash.astro";
import Base from "@/layouts/Base.astro";
import Constellation from "@/components/Constellation.astro";
import { site, contact, socials } from "@/data/site";
---

<Base title="Connect" fullscreen footerEmail={false}>
  <Constellation />
  <section class="contact container">
    <h1 class="visually-hidden">Connect</h1>
    <a class="contact__email swash-link" href={`mailto:${site.email}`}>
      {site.email}
      <Swash />
    </a>
    <p class="contact__note">{contact.note}</p>
    {(site.location || socials.length > 0) && (
      <div class="contact__details">
        {site.location && <p>{site.location}</p>}
        {socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener">{s.label}</a>
        ))}
      </div>
    )}
  </section>
</Base>
